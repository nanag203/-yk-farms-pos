// app/api/daily-report/route.js
// YK Farms daily AI report: pulls sales + expenses + debts from Supabase,
// asks Claude to write a short report with ideas, optionally texts it to you.

import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

export const dynamic = "force-dynamic";
export const maxDuration = 60;

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL,
  process.env.SUPABASE_SERVICE_ROLE_KEY
);

const num = (v) => Number(v) || 0;

// Accra is UTC+0, so UTC days = Accra days
function dayStart(daysAgo) {
  const d = new Date();
  d.setUTCHours(0, 0, 0, 0);
  d.setUTCDate(d.getUTCDate() - daysAgo);
  return d.toISOString();
}

// Sales with customer name and items (with each product's cost price)
async function fetchSales(fromISO, toISO) {
  let q = supabase
    .from("sales")
    .select(
      "id, sale_date, total_amount, amount_paid, payment_status, customers(name), sale_items(quantity, unit_price, subtotal, products(name, cost_price))"
    )
    .gte("sale_date", fromISO);
  if (toISO) q = q.lt("sale_date", toISO);
  const { data, error } = await q.limit(5000);
  if (error) throw new Error(`sales: ${error.message}`);
  return data || [];
}

async function fetchExpenses(fromISO, toISO) {
  let q = supabase
    .from("expenses")
    .select("category, amount, description, expense_date")
    .gte("expense_date", fromISO);
  if (toISO) q = q.lt("expense_date", toISO);
  const { data, error } = await q.limit(5000);
  if (error) throw new Error(`expenses: ${error.message}`);
  return data || [];
}

const customerName = (s) => s.customers?.name || "Walk-in";

// Cost of the eggs sold = quantity x product cost_price
function saleCost(s) {
  return (s.sale_items || []).reduce(
    (sum, i) => sum + num(i.quantity) * num(i.products?.cost_price),
    0
  );
}

function summarize(sales, expenses) {
  const revenue = sales.reduce((s, r) => s + num(r.total_amount), 0);
  const cashCollected = sales.reduce((s, r) => s + num(r.amount_paid), 0);
  const cogs = sales.reduce((s, r) => s + saleCost(r), 0);
  const exp = expenses.reduce((s, r) => s + num(r.amount), 0);
  return {
    orders: sales.length,
    revenue,
    cashCollected,
    soldOnCredit: revenue - cashCollected,
    costOfGoodsSold: cogs,
    grossProfit: revenue - cogs,
    expenses: exp,
    netProfit: revenue - cogs - exp,
  };
}

function topCustomers(sales, n = 5) {
  const map = {};
  for (const r of sales) {
    const name = customerName(r);
    map[name] = (map[name] || 0) + num(r.total_amount);
  }
  return Object.entries(map)
    .sort((a, b) => b[1] - a[1])
    .slice(0, n)
    .map(([name, total]) => ({ name, total }));
}

function expenseBreakdown(expenses) {
  const map = {};
  for (const r of expenses) {
    const c = r.category || "Other";
    map[c] = (map[c] || 0) + num(r.amount);
  }
  return map;
}

// Customers who bought in the last 60 days but not in the last 14 days
function quietCustomers(sales60) {
  const cutoff = new Date(dayStart(14)).getTime();
  const last = {};
  for (const r of sales60) {
    const name = r.customers?.name;
    if (!name) continue;
    const t = new Date(r.sale_date).getTime();
    const cur = last[name] || { t: 0, total: 0 };
    last[name] = { t: Math.max(cur.t, t), total: cur.total + num(r.total_amount) };
  }
  return Object.entries(last)
    .filter(([, v]) => v.t < cutoff)
    .map(([name, v]) => ({
      name,
      daysSinceLastOrder: Math.floor((Date.now() - v.t) / 86400000),
      spentLast60Days: v.total,
    }))
    .sort((a, b) => b.spentLast60Days - a.spentLast60Days)
    .slice(0, 8);
}

async function outstandingDebts() {
  const { data, error } = await supabase
    .from("debts")
    .select("balance, customers(name)")
    .gt("balance", 0)
    .order("balance", { ascending: false })
    .limit(2000);
  if (error || !data) return null;
  return {
    total: data.reduce((s, r) => s + num(r.balance), 0),
    top: data.slice(0, 5).map((r) => ({
      name: r.customers?.name || "Unknown",
      owes: num(r.balance),
    })),
  };
}

async function lowStock() {
  const { data, error } = await supabase
    .from("products")
    .select("name, current_stock, low_stock_alert");
  if (error || !data) return [];
  return data
    .filter((p) => num(p.current_stock) <= num(p.low_stock_alert))
    .map((p) => ({ name: p.name, stock: num(p.current_stock) }));
}

async function askClaude(facts) {
  const res = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": process.env.ANTHROPIC_API_KEY,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: "claude-sonnet-5-5",
      max_tokens: 700,
      system:
        "You are the business assistant for YK Farms, an egg sourcing and supply business in Accra, Ghana. " +
        "Write a short daily report for the owner, Nana. Plain text, no markdown, casual and direct like a sharp business partner. " +
        "Format: 1) Today in two lines (sales, net profit, vs yesterday). 2) Week so far vs last week. " +
        "3) Three specific ideas for tomorrow based ONLY on the numbers given (who to call, what to push, what to cut, debts to chase, stock to reorder). " +
        "Never invent numbers. If figures are zero or missing, say the data looks incomplete instead of guessing. Keep it under 180 words. Amounts are in Ghana cedis (GHS).",
      messages: [{ role: "user", content: JSON.stringify(facts) }],
    }),
  });
  if (!res.ok) throw new Error(`Claude API ${res.status}: ${await res.text()}`);
  const data = await res.json();
  return (data.content || [])
    .filter((b) => b.type === "text")
    .map((b) => b.text)
    .join("\n")
    .trim();
}

// Optional SMS via Arkesel. Skipped if env vars are not set.
async function sendSMS(message) {
  const key = process.env.ARKESEL_API_KEY;
  const to = process.env.REPORT_PHONE; // e.g. 233XXXXXXXXX
  if (!key || !to) return { sent: false, reason: "SMS env vars not set" };
  const params = new URLSearchParams({
    action: "send-sms",
    api_key: key,
    to,
    from: process.env.ARKESEL_SENDER_ID || "YKFarms",
    sms: message,
  });
  const r = await fetch(`https://sms.arkesel.com/sms/api?${params.toString()}`);
  return { sent: r.ok, status: r.status };
}

export async function GET(req) {
  // Protect the route. Vercel Cron sends this header automatically when CRON_SECRET is set.
  const auth = req.headers.get("authorization");
  if (process.env.CRON_SECRET && auth !== `Bearer ${process.env.CRON_SECRET}`) {
    return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
  }

  try {
    const [today, yesterday, thisWeek, lastWeek, sales60] = await Promise.all([
      fetchSales(dayStart(0)),
      fetchSales(dayStart(1), dayStart(0)),
      fetchSales(dayStart(6)),
      fetchSales(dayStart(13), dayStart(6)),
      fetchSales(dayStart(60)),
    ]);
    const [expToday, expYesterday, expWeek, expLastWeek] = await Promise.all([
      fetchExpenses(dayStart(0)),
      fetchExpenses(dayStart(1), dayStart(0)),
      fetchExpenses(dayStart(6)),
      fetchExpenses(dayStart(13), dayStart(6)),
    ]);

    const facts = {
      date: new Date().toISOString().slice(0, 10),
      today: summarize(today, expToday),
      yesterday: summarize(yesterday, expYesterday),
      last7Days: summarize(thisWeek, expWeek),
      previous7Days: summarize(lastWeek, expLastWeek),
      topCustomersLast7Days: topCustomers(thisWeek),
      expensesLast7DaysByCategory: expenseBreakdown(expWeek),
      customersGoneQuiet: quietCustomers(sales60),
      debts: await outstandingDebts(),
      lowStockProducts: await lowStock(),
    };

    const report = await askClaude(facts);
    const sms = await sendSMS(report);

    return NextResponse.json({ report, sms, facts });
  } catch (e) {
    return NextResponse.json({ error: e.message }, { status: 500 });
  }
}

